  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<line-height=70%>

    <align="center"><size=140%><b>HOW TO PLAY</b></size></align>


    <b>1.
    The Field:</b> Players stand on a grid of numbered <color=#00FFFF>Mines Plates</color>.


    <b>2.
    The Turn:</b> Players take turns one by one. On your turn, you must choose and
    activate a single plate.


    <b>3. The Outcome:</b>

    * If the plate is
    <b><color=#00FF00>Safe</color></b>, you stay in the game and the next player
    takes their turn.

    * If the plate is a <b><color=#FF0000>Mine</color></b>,
    you are eliminated from the round.


    <b>4. Winning:</b> The game continues
    until only one player is left. The <b><color=#FFFF00>Last One Standing</color></b>
    wins the match.

    </line-height>'
