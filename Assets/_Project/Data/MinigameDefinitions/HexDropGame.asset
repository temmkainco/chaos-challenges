  m_Script: {fileID: 11500000, guid: 89cbc515f664c394fa76e13533db2330, type: 3}
  m_Name: HexDropGame
  m_EditorClassIdentifier: Assembly-CSharp::MinigameDefinition
  <Id>k__BackingField: hex_drop
  <SceneBuildIndex>k__BackingField: 10
  <GameType>k__BackingField: 2
  <GameDuration>k__BackingField: 90
  <IsTimeLimited>k__BackingField: 1
  <StartDelay>k__BackingField: 3
  <DisplayName>k__BackingField: Hex Drop
  <Description>k__BackingField: Three floors of hexagon tiles, and every tile you
    touch falls away. Keep moving and be the last one up!
  <PreviewImage>k__BackingField: {fileID: 21300000, guid: 9a3908abd171bd84e9a9c116d27c1d24, type: 3}
  <Rules>k__BackingField:
  - Tiles crack red, then drop - keep moving
  - Drop to a lower floor on purpose to buy time
  - 'Empty hands: left mouse shoves a rival'
  <Objective>k__BackingField: Be the last contestant still standing on the tiles.
  <Danger>k__BackingField: Tiles drop a moment after you step on them. Fall through
    the bottom floor and you're out.
  <Scoring>k__BackingField: Last one standing wins; the later you fall, the better
    you place.
  <Controls>k__BackingField:
  - LMB|Shove a rival
