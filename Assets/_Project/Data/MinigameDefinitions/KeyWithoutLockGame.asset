  m_Script: {fileID: 11500000, guid: 89cbc515f664c394fa76e13533db2330, type: 3}
  m_Name: KeyWithoutLockGame
  m_EditorClassIdentifier: Assembly-CSharp::MinigameDefinitionSO
  <Id>k__BackingField: key_without_lock
  <SceneBuildIndex>k__BackingField: 8
  <GameType>k__BackingField: 3
  <GameDuration>k__BackingField: 90
  <IsTimeLimited>k__BackingField: 1
  <StartDelay>k__BackingField: 3
  <DisplayName>k__BackingField: Key Hunt
  <Description>k__BackingField: Musical chairs with keys! There is one door fewer
    than contestants. Find a key, run to the door of its colour and get out.
  <PreviewImage>k__BackingField: {fileID: 21300000, guid: e4fecb9172fee5c48bcdedbf6fb21de6, type: 3}
  <Rules>k__BackingField:
  - Grab a key with E - its colour is its door
  - Press E at the door of that colour to escape
  - No key? Shove someone holding one to knock it loose
  <Objective>k__BackingField: Escape through the door that matches your key's colour.
  <Danger>k__BackingField: Each door lets one contestant out, then shuts. Whoever
    is left inside at the end loses.
  <Scoring>k__BackingField: Escape order decides the places; the last one inside
    places last.
  <Controls>k__BackingField:
  - E|Grab a key / open a door
  - LMB|Shove a key-holder
