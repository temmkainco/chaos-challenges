  m_Script: {fileID: 11500000, guid: 89cbc515f664c394fa76e13533db2330, type: 3}
  m_Name: BombRushGame
  m_EditorClassIdentifier: Assembly-CSharp::MinigameDefinitionSO
  <Id>k__BackingField: bomb_rush
  <SceneBuildIndex>k__BackingField: 6
  <GameType>k__BackingField: 2
  <GameDuration>k__BackingField: 120
  <IsTimeLimited>k__BackingField: 1
  <StartDelay>k__BackingField: 3
  <DisplayName>k__BackingField: Bomb Rush
  <Description>k__BackingField: Island wars! Everyone gets their own island and a
    bomb every few seconds. Blow the others off theirs!
  <PreviewImage>k__BackingField: {fileID: 21300000, guid: 481d60a0613826f4aafabeba97c1a827, type: 3}
  <Rules>k__BackingField:
  - Grab the bomb on your island
  - Throw it at a rival's island
  - Don't hold a bomb too long
  <Objective>k__BackingField: Be the last one left on an island.
  <Danger>k__BackingField: A bomb going off in your hands or right next to you knocks
    you out; a blast nearby can throw you off your island.
  <Scoring>k__BackingField: Last one standing wins; the later you fall, the better
    you place.
  <Controls>k__BackingField:
  - E|Grab / drop a bomb
  - Hold LMB|Aim, release to throw
  - LMB (empty hands)|Shove
