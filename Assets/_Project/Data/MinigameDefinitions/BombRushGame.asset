  m_Script: {fileID: 11500000, guid: 89cbc515f664c394fa76e13533db2330, type: 3}
  m_Name: BombRushGame
  m_EditorClassIdentifier: Assembly-CSharp::MinigameDefinitionSO
  <Id>k__BackingField: bomb_rush
  <SceneBuildIndex>k__BackingField: 6
  <GameType>k__BackingField: 2
  <GameDuration>k__BackingField: 120
  <IsTimeLimited>k__BackingField: 1
  <StartDelay>k__BackingField: 3
  <DisplayName>k__BackingField: Bomb Rush
  <Description>k__BackingField: Conveyors keep the bombs coming. Grab one, throw
    it at a rival and blast them off the stage. Last contestant standing wins!
  <PreviewImage>k__BackingField: {fileID: 21300000, guid: 481d60a0613826f4aafabeba97c1a827, type: 3}
  <Rules>k__BackingField:
  - Grab a bomb (E), hold left mouse to aim, release to throw
  - The red ring under a lit bomb shows what its blast catches
  - Don't hold a lit bomb for long!
  <Objective>k__BackingField: Blast everyone else off the stage with bombs.
  <Danger>k__BackingField: A bomb going off in your hands or inside its red ring
    knocks you out; farther away it throws you.
  <Scoring>k__BackingField: Last one standing wins; the order you fall decides the
    rest.
  <Controls>k__BackingField:
  - E|Grab / drop a bomb
  - Hold LMB|Aim, release to throw
  - LMB (empty hands)|Shove
