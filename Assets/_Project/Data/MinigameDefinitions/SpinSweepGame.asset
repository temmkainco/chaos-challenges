  m_Name: SpinSweepGame
  m_EditorClassIdentifier: Assembly-CSharp::MinigameDefinition
  <Id>k__BackingField: spin_sweep
  <SceneBuildIndex>k__BackingField: 15
  <GameType>k__BackingField: 2
  <GameDuration>k__BackingField: 90
  <IsTimeLimited>k__BackingField: 1
  <StartDelay>k__BackingField: 3
  <DisplayName>k__BackingField: Spin Sweep
  <Description>k__BackingField: Bars sweep round the floor, faster and faster. Jump
    them - and watch for tiles dropping out!
  <PreviewImage>k__BackingField: {fileID: 21300000, guid: 3c2feb932c8a9994db0a6b969ea158d5, type: 3}
  <Rules>k__BackingField:
  - Jump as a bar comes round
  - Bars speed up over time
  - Red tiles are about to drop
  <Objective>k__BackingField: Be the last one left on the floor.
  <Danger>k__BackingField: A bar that catches you flings you off. Tiles crack red,
    then drop.
  <Scoring>k__BackingField: Last one standing wins; the later you fall, the better
    you place.
  <Controls>k__BackingField:
  - SPACE|Jump the bars
  - LMB|Shove
